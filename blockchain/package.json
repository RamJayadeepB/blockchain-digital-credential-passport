{
  "name": "credential-passport-blockchain",
  "version": "1.0.0",
  "description": "Smart contracts, DID/VC library and demo scripts for the Digital Credential Passport",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "gas": "cross-env REPORT_GAS=1 hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "demo:local": "hardhat run scripts/demo-flow.js --network localhost",
    "storage:local": "hardhat run scripts/show-storage.js --network localhost",
    "metrics:local": "hardhat run scripts/metrics.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "demo:sepolia": "hardhat run scripts/demo-flow.js --network sepolia",
    "storage:sepolia": "hardhat run scripts/show-storage.js --network sepolia",
    "metrics:sepolia": "cross-env RUNS=5 hardhat run scripts/metrics.js --network sepolia"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "ethr-did-registry": "^2.0.0",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^1.0.10",
    "solc": "0.8.24"
  },
  "dependencies": {
    "did-jwt": "^9.0.3",
    "did-jwt-vc": "^5.0.2",
    "did-resolver": "^6.0.0",
    "ethers": "^6.17.0",
    "ethr-did-resolver": "^14.1.4",
    "qrcode": "^1.5.4"
  },
  "private": true
}
